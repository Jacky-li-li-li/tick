{
  "name": "@tick/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Tick desktop — always-on-top todo panel",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "tsc -p tsconfig.node.json --noEmit && vite build && electron-builder --mac --publish never",
    "dist:dir": "tsc -p tsconfig.node.json --noEmit && vite build && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-durable": "^1.2.0",
    "@tick/ai-core": "workspace:*",
    "@tick/ai-pi": "workspace:*",
    "@tick/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.jackyli.tick",
    "productName": "Tick",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "afterPack": "build/after-pack.mjs",
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "Developer ID Application",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Tick ${version}"
    }
  },
  "type": "module"
}
