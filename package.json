{
  "name": "tick",
  "private": true,
  "version": "0.1.5",
  "description": "Tick — always-on-top desktop todo panel",
  "scripts": {
    "dev": "pnpm --filter @tick/desktop dev",
    "build": "pnpm --filter @tick/desktop build",
    "desktop": "pnpm --filter @tick/desktop dev",
    "dist": "pnpm --filter @tick/desktop dist",
    "verify:sign": "node scripts/verify-signature.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx packages/ai/core/test/session-policy.test.mts && tsx packages/ai/pi/test/session-id.test.mts && tsx packages/ai/pi/test/pi-adapter.test.mts && tsx apps/desktop/test/resume-target.test.mts && tsx packages/ai/pi/test/argv.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
